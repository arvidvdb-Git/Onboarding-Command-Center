  <script>
    // Dynamic Department Filtering Logic
    function handleDepartmentChange(value) {
      const marketingGroups = document.querySelectorAll('.marketing-task-group');
      const toggleGeneral = document.getElementById('toggleGeneral');
      const departmentSelect = document.getElementById('departmentSelect');
      
      if (value === 'Marketing') {
        marketingGroups.forEach(el => el.classList.remove('hidden'));
        toggleGeneral.classList.remove('bg-white', 'text-slate-900', 'font-semibold', 'shadow-sm');
        toggleGeneral.classList.add('text-slate-600');
      } else {
        marketingGroups.forEach(el => el.classList.add('hidden'));
        if (value === 'General') {
          toggleGeneral.classList.add('bg-white', 'text-slate-900', 'font-semibold', 'shadow-sm');
          toggleGeneral.classList.remove('text-slate-600');
        }
      }
    }

    function setDepartmentFilter(filter) {
      const departmentSelect = document.getElementById('departmentSelect');
      if (filter === 'General') {
        departmentSelect.value = 'General';
        handleDepartmentChange('General');
      }
    }

    // Modal Control
    function openNewEmployeeModal() {
      document.getElementById('newEmployeeModal').classList.remove('hidden');
    }
    function closeNewEmployeeModal() {
      document.getElementById('newEmployeeModal').classList.add('hidden');
    }
    function submitNewEmployee(e) {
      e.preventDefault();
      alert('n8n Webhook Triggered: Employee onboarding pipeline initialized!');
      closeNewEmployeeModal();
    }

    // Sync button feedback
    function simulateSync() {
      const icon = document.getElementById('syncIcon');
      const text = document.getElementById('syncText');
      icon.classList.add('animate-spin');
      text.textContent = 'Syncing...';
      setTimeout(() => {
        icon.classList.remove('animate-spin');
        text.textContent = 'Synced (Just now)';
      }, 1000);
    }

    // Chatbot toggling
    function toggleChatbot() {
      const drawer = document.getElementById('chatDrawer');
      drawer.classList.toggle('hidden');
    }

    function sendChatMessage() {
      const input = document.getElementById('chatInput');
      const msg = input.value.trim();
      if (!msg) return;
      
      const container = document.getElementById('chatMessages');
      const userDiv = document.createElement('div');
      userDiv.className = 'bg-slate-900 text-white p-2.5 rounded-xl text-xs ml-auto max-w-[85%]';
      userDiv.textContent = msg;
      container.appendChild(userDiv);
      input.value = '';

      setTimeout(() => {
        const replyDiv = document.createElement('div');
        replyDiv.className = 'bg-white p-2.5 rounded-xl border border-[#e5dfd2] text-slate-700 max-w-[85%] shadow-xs text-xs';
        replyDiv.textContent = `[n8n Subagent] Received instruction: "${msg}". Querying active pipeline status...`;
        container.appendChild(replyDiv);
        container.scrollTop = container.scrollHeight;
      }, 600);
      container.scrollTop = container.scrollHeight;
    }

    function sendQuickPrompt(prompt) {
      document.getElementById('chatInput').value = prompt;
      sendChatMessage();
    }
  </script>
